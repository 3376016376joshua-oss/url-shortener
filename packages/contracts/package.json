{
  "name": "@url-shortener/contracts",
  "version": "0.1.0",
  "description": "Request and response schemas shared by the API and the dashboard",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"

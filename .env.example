# Copy to .env to run the app on your machine (pnpm start:dev) against the
# Postgres and Redis from Docker Compose. docker compose up needs no .env.
# Every variable is described in docs/PRD.md, section 13.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379
TRUST_PROXY_HOPS=0

# Comma-separated ownerId:key pairs, for example alice:replace-with-a-long-random-key
API_KEYS=

# Comma-separated hosts refused as destinations, subdomains included
BLOCKED_HOSTS=

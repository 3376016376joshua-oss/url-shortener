# Configuration of the production stack (deploy/docker-compose.production.yml).
# Copy to deploy/production.env, fill it in, and keep it out of version
# control: it holds secrets. Every application variable is described in
# docs/PRD.md, section 16; the runbook is docs/operations.md.

# --- Images -----------------------------------------------------------------
# The images to run. Leave unset to build them from this checkout.
# API_IMAGE=registry.example.com/shortener-api:1.0.0
# EDGE_IMAGE=registry.example.com/shortener-edge:1.0.0

# --- Hosts ------------------------------------------------------------------
# The host that serves the dashboard and the management API ...
APP_HOST=app.example.com
# ... and its origin, exactly as a browser sees it.
APP_URL=https://app.example.com
# The platform's own short domain, usable by every workspace.
DEFAULT_SHORT_DOMAIN=sho.example
# The host customers point their domains' CNAME at. It resolves to this host.
CNAME_TARGET=cname.sho.example
# Where the certificate authority sends expiry notices.
ACME_EMAIL=ops@example.com

# --- Secrets ----------------------------------------------------------------
# At least 32 characters; generate with: openssl rand -base64 48
# Changing it reassigns every A/B test visitor, so set it once.
APP_SECRET=

# Managed Postgres (recommended). With `--profile postgres`, use instead
#   postgres://shortener:<POSTGRES_PASSWORD>@postgres:5432/shortener
DATABASE_URL=postgres://shortener:CHANGE-ME@db.example.com:5432/shortener?sslmode=require
# Only with `--profile postgres`: the password of the container's database.
# POSTGRES_PASSWORD=

SMTP_URL=smtps://user:CHANGE-ME@smtp.example.com:465
MAIL_FROM=no-reply@example.com

# --- Abuse and limits -------------------------------------------------------
# Comma-separated hosts refused as destinations, subdomains included.
BLOCKED_HOSTS=
# Requests per minute; the defaults are those of docs/PRD.md section 13.
# RATE_LIMIT_REDIRECT_PER_MINUTE=600
# RATE_LIMIT_API_PER_MINUTE=300
# RATE_LIMIT_CREDENTIAL_PER_MINUTE=600
# RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Capacity ---------------------------------------------------------------
# WEB_REPLICAS=2
# WORKER_REPLICAS=1
# Redis memory limit. Alert when usage passes 80% of it.
# REDIS_MAXMEMORY=512mb

# --- Data on the host -------------------------------------------------------
# A directory holding country.mmdb, a MaxMind-format country database.
# GEOIP_DIR=./geoip
# Where daily dumps are written. Mount storage that is not this host's disk.
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30
# Only with `--profile postgres`: where WAL segments are archived. Likewise
# storage that is not this host's disk.
# WAL_ARCHIVE_DIR=/mnt/offsite/wal-archive

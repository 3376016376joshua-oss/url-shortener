{
  "name": "@url-shortener/api",
  "version": "0.1.0",
  "description": "The API, the redirect service, and the background workers",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migration:run": "node --env-file-if-exists=.env dist/database/run-migrations.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/typeorm": "^12.0.3",
    "@url-shortener/contracts": "workspace:*",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^6.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }

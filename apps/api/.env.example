# Copy to .env to run the API on your machine (pnpm --filter @url-shortener/api
# start:dev) against the services from Docker Compose. docker compose up needs
# no .env. Every variable is described in docs/PRD.md, section 16.

NODE_ENV=development
PORT=3000
PROCESS_ROLE=all

DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379

# The dashboard and API origin, the platform's short domain, and the host that
# custom domains point their CNAME at.
APP_URL=http://localhost:5173
DEFAULT_SHORT_DOMAIN=sho.localhost
CNAME_TARGET=cname.sho.localhost

# At least 32 characters. Generate one with: openssl rand -base64 48
APP_SECRET=

TRUST_PROXY_HOPS=0

# Mailpit from Docker Compose catches mail; read it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@sho.localhost

# Path to a MaxMind-format country database. Unset: countries are "unknown".
# GEOIP_DB_PATH=

# Comma-separated hosts refused as destinations, subdomains included
BLOCKED_HOSTS=

# Requests per minute
RATE_LIMIT_REDIRECT_PER_MINUTE=600
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_CREDENTIAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=10
